APP_ENV=local
APP_NAME=UAE Government AI Assistant API
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
POSTGRES_DB=uae_ai
POSTGRES_USER=uae_ai
POSTGRES_PASSWORD=uae_ai_local
# Host-side Python scripts use published localhost ports. Docker overrides these internally.
DATABASE_URL=postgresql+asyncpg://uae_ai:uae_ai_local@localhost:5432/uae_ai
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,backend
READY_CHECK_TIMEOUT_SECONDS=2.0

# Milestone 4 RAG
EMBEDDING_PROVIDER=e5
EMBEDDING_MODEL=intfloat/multilingual-e5-small
LLM_PROVIDER=extractive
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
# Set these only for a hosted OpenAI-compatible provider when you know its current prices.
LLM_PROMPT_COST_PER_MILLION_USD=
LLM_COMPLETION_COST_PER_MILLION_USD=
RAG_MINIMUM_SUPPORT=0.20
RAG_MINIMUM_FOCUS_SUPPORT=0.60

# Milestone 5 bounded tools/agent
AGENT_MAX_TOOL_CALLS=3

# Milestone 8 production engineering
CACHE_ENABLED=true
CACHE_NAMESPACE=uae-ai-assistant
# Bump CACHE_VERSION after a corpus/retrieval contract change that should invalidate old responses.
CACHE_VERSION=m8-v1
CACHE_TTL_SECONDS=300

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_OPEN=true
# Enable only when the backend is private behind a trusted reverse proxy that sets X-Forwarded-For.
RATE_LIMIT_TRUST_FORWARDED_FOR=false

MAX_REQUEST_BODY_BYTES=16384
SECURITY_HEADERS_ENABLED=true
OPS_METRICS_ENABLED=true
# Required when APP_ENV=production and OPS_METRICS_ENABLED=true.
OPS_METRICS_TOKEN=

# Milestone 9 managed deployment notes
# Neon may issue postgresql:// URLs with sslmode=require/channel_binding=require; M9 adapts these
# safely for SQLAlchemy + asyncpg. Prefer a direct/unpooled Neon URL for this low-traffic demo.
# DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require&channel_binding=require
# Upstash Redis uses TLS for the redis-py connection.
# REDIS_URL=rediss://default:<password>@<upstash-host>:<port>
# Production frontend/backend host examples (replace with your real deployment hosts):
# CORS_ORIGINS=https://<vercel-project>.vercel.app
# TRUSTED_HOSTS=<hf-username>-<space-name>.hf.space,localhost,127.0.0.1
# APP_ENV=production
